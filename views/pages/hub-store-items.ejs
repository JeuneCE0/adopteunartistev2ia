        <!-- ADD PRODUCT BAR -->
        <div style="margin-bottom:24px;">
          <button id="hub-add-product-btn" class="button medium primary">+ Ajouter un produit</button>
        </div>

        <!-- PRODUCTS LIST -->
        <div id="hub-products-list">
          <!-- Loaded dynamically -->
        </div>

        <!-- PRODUCT MODAL (reusable) -->
        <div id="hub-product-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:99999;overflow-y:auto;">
          <div style="max-width:560px;margin:60px auto;background:#fff;border-radius:16px;padding:32px;position:relative;">
            <button id="hub-modal-close" style="position:absolute;top:16px;right:16px;background:none;border:none;font-size:24px;cursor:pointer;color:#9aa4bf;">&times;</button>
            <h3 id="hub-modal-title" style="font-size:18px;font-weight:700;margin-bottom:24px;">Ajouter un produit</h3>
            <form id="hub-product-form">
              <input type="hidden" id="hub-pf-id" value="">
              <div style="margin-bottom:16px;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Titre *</label>
                <input type="text" id="hub-pf-title" required style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="Nom du produit ou service">
              </div>
              <div style="margin-bottom:16px;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Description</label>
                <textarea id="hub-pf-description" rows="3" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;resize:vertical;" placeholder="Decrivez votre produit..."></textarea>
              </div>
              <div style="display:flex;gap:12px;margin-bottom:16px;">
                <div style="flex:1;">
                  <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Prix (EUR) *</label>
                  <input type="number" id="hub-pf-price" min="0" step="0.01" required style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="0.00">
                </div>
                <div style="flex:1;">
                  <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Type</label>
                  <select id="hub-pf-type" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;background:#fff;">
                    <option value="digital">Digital</option>
                    <option value="physical">Physique</option>
                    <option value="service">Service</option>
                    <option value="commission">Commission</option>
                  </select>
                </div>
              </div>
              <div style="display:flex;gap:12px;margin-bottom:16px;">
                <div style="flex:1;">
                  <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Categorie</label>
                  <input type="text" id="hub-pf-category" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="Art, Musique...">
                </div>
                <div style="flex:1;">
                  <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Stock (-1 = illimite)</label>
                  <input type="number" id="hub-pf-stock" min="-1" value="-1" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;">
                </div>
              </div>
              <div style="margin-bottom:16px;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Image</label>
                <input type="file" id="hub-pf-image" accept="image/*" style="width:100%;padding:10px;border:1px solid #dedeea;border-radius:12px;font-size:13px;">
              </div>
              <div style="margin-bottom:20px;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Lien de telechargement</label>
                <input type="url" id="hub-pf-download-url" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="https://...">
              </div>
              <div style="display:flex;gap:12px;">
                <button type="submit" id="hub-pf-submit" class="button medium primary" style="flex:1;">Publier</button>
                <button type="button" id="hub-pf-cancel" class="button medium" style="flex:0;background:#eaeaf5;color:#3e3f5e;">Annuler</button>
              </div>
            </form>
          </div>
        </div>

