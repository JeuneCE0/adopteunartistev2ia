<!-- global.accordions -->
<script src="js/global/global.accordions.js"></script>
<!-- global.popups -->
<script src="js/global/global.popups.js"></script>
<script src="js/api/products.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;

  var listEl = document.getElementById('hub-products-list');
  var modal = document.getElementById('hub-product-modal');
  var form = document.getElementById('hub-product-form');
  var addBtn = document.getElementById('hub-add-product-btn');
  var closeBtn = document.getElementById('hub-modal-close');
  var cancelBtn = document.getElementById('hub-pf-cancel');
  var modalTitle = document.getElementById('hub-modal-title');
  var submitBtn = document.getElementById('hub-pf-submit');

  function openModal(product) {
    form.reset();
    document.getElementById('hub-pf-id').value = '';
    if (product) {
      modalTitle.textContent = 'Modifier le produit';
      submitBtn.textContent = 'Enregistrer';
      document.getElementById('hub-pf-id').value = product.id;
      document.getElementById('hub-pf-title').value = product.title || '';
      document.getElementById('hub-pf-description').value = product.description || '';
      document.getElementById('hub-pf-price').value = product.price || '';
      document.getElementById('hub-pf-type').value = product.type || 'digital';
      document.getElementById('hub-pf-category').value = product.category || '';
      document.getElementById('hub-pf-stock').value = product.stock != null ? product.stock : -1;
      document.getElementById('hub-pf-download-url').value = product.download_url || '';
    } else {
      modalTitle.textContent = 'Ajouter un produit';
      submitBtn.textContent = 'Publier';
    }
    modal.style.display = '';
    document.body.style.overflow = 'hidden';
  }
  function closeModal() { modal.style.display = 'none'; document.body.style.overflow = ''; }

  addBtn.addEventListener('click', function() { openModal(null); });
  closeBtn.addEventListener('click', closeModal);
  cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

  // Submit
  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    var editId = document.getElementById('hub-pf-id').value;
    submitBtn.disabled = true;
    submitBtn.textContent = editId ? 'Enregistrement...' : 'Publication...';
    try {
      if (editId) {
        await ProductsAPI.update(editId, {
          title: document.getElementById('hub-pf-title').value.trim(),
          description: document.getElementById('hub-pf-description').value.trim(),
          price: parseFloat(document.getElementById('hub-pf-price').value),
          type: document.getElementById('hub-pf-type').value,
          category: document.getElementById('hub-pf-category').value.trim(),
          stock: parseInt(document.getElementById('hub-pf-stock').value) || -1,
          download_url: document.getElementById('hub-pf-download-url').value.trim()
        });
        PageInit.toast('Produit modifie !', 'success');
      } else {
        var fd = new FormData();
        fd.append('title', document.getElementById('hub-pf-title').value.trim());
        fd.append('description', document.getElementById('hub-pf-description').value.trim());
        fd.append('price', document.getElementById('hub-pf-price').value);
        fd.append('type', document.getElementById('hub-pf-type').value);
        fd.append('category', document.getElementById('hub-pf-category').value.trim());
        fd.append('stock', document.getElementById('hub-pf-stock').value || '-1');
        var dlUrl = document.getElementById('hub-pf-download-url').value.trim();
        if (dlUrl) fd.append('download_url', dlUrl);
        var imageFile = document.getElementById('hub-pf-image').files[0];
        if (imageFile) fd.append('image', imageFile);
        await ProductsAPI.create(fd);
        PageInit.toast('Produit publie !', 'success');
      }
      closeModal();
      loadProducts();
    } catch(err) {
      PageInit.toast(err.message || 'Erreur', 'error');
      submitBtn.disabled = false;
      submitBtn.textContent = editId ? 'Enregistrer' : 'Publier';
    }
  });

  // Delete
  async function deleteProduct(id) {
    if (!confirm('Supprimer ce produit ?')) return;
    try { await ProductsAPI.delete(id); PageInit.toast('Supprime', 'success'); loadProducts(); }
    catch(err) { PageInit.toast(err.message || 'Erreur', 'error'); }
  }

  // Load products
  async function loadProducts() {
    PageInit.showLoading(listEl);
    try {
      var data = await ProductsAPI.getMyProducts();
      var products = data.products || [];
      if (products.length === 0) {
        PageInit.showEmpty(listEl, '&#x1F3A8;', 'Aucun produit', 'Ajoutez votre premier produit pour commencer a vendre !');
        return;
      }
      var typeLabels = { digital: 'Digital', physical: 'Physique', service: 'Service', commission: 'Commission' };
      var statusLabels = { active: 'Actif', draft: 'Brouillon', sold_out: 'Epuise', archived: 'Archive' };
      var statusColors = { active: '#4caf50', draft: '#f39c12', sold_out: '#e74c3c', archived: '#9aa4bf' };
      var html = '<div class="widget-box"><div class="widget-box-content">';
      products.forEach(function(p) {
        html += '<div class="aua-fade-in" style="padding:16px;border-bottom:1px solid #eaeaf5;display:flex;align-items:center;gap:16px;">' +
          '<a href="marketplace-product.html?id=' + p.id + '"><img src="' + (p.image_url || 'img/marketplace/items/01.jpg') + '" style="width:70px;height:70px;object-fit:cover;border-radius:10px;"></a>' +
          '<div style="flex:1;min-width:0;">' +
            '<a href="marketplace-product.html?id=' + p.id + '" style="font-weight:700;font-size:14px;color:#3e3f5e;">' + (p.title || '') + '</a>' +
            '<div style="display:flex;gap:8px;align-items:center;margin-top:4px;flex-wrap:wrap;">' +
              '<span style="color:#615dfa;font-weight:700;">' + parseFloat(p.price || 0).toFixed(2) + ' EUR</span>' +
              '<span style="background:' + (statusColors[p.status] || '#9aa4bf') + ';color:#fff;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;">' + (statusLabels[p.status] || p.status) + '</span>' +
              '<span style="font-size:11px;color:#9aa4bf;">' + (typeLabels[p.type] || p.type || '') + '</span>' +
              (p.category ? '<span style="font-size:11px;color:#9aa4bf;">' + p.category + '</span>' : '') +
            '</div>' +
          '</div>' +
          '<div style="display:flex;gap:6px;flex-shrink:0;">' +
            '<button class="hub-edit-btn button small secondary" data-product=\'' + JSON.stringify(p).replace(/'/g, '&#39;') + '\' style="font-size:12px;padding:6px 12px;">Modifier</button>' +
            '<button class="hub-delete-btn button small" data-id="' + p.id + '" style="font-size:12px;padding:6px 12px;background:#fee;color:#e74c3c;">Supprimer</button>' +
          '</div>' +
        '</div>';
      });
      html += '</div></div>';
      listEl.innerHTML = html;

      listEl.querySelectorAll('.hub-edit-btn').forEach(function(btn) {
        btn.addEventListener('click', function() { openModal(JSON.parse(this.getAttribute('data-product'))); });
      });
      listEl.querySelectorAll('.hub-delete-btn').forEach(function(btn) {
        btn.addEventListener('click', function() { deleteProduct(this.getAttribute('data-id')); });
      });
    } catch(e) {
      PageInit.showEmpty(listEl, '&#x26A0;', 'Erreur', e.message || 'Impossible de charger vos produits');
    }
  }

  loadProducts();
});
</script>
