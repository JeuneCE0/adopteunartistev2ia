<!-- tiny-slider -->
<script src="js/vendor/tiny-slider.min.js"></script>
<!-- API modules -->
<script src="js/api/auth.js"></script>
<script src="js/api/friends.js"></script>
<script src="js/api/messages.js"></script>
<script src="js/api/users.js"></script>
<script src="js/api/forums.js"></script>
<script src="js/utils/page-init.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;
  var userId = PageInit.getUrlParam('id') || PageInit.user.id;
  await PageInit.loadProfileHeader(userId);

  var contentArea = document.querySelector('.grid.grid-9-3 .grid-column:first-child, .table-body, .forum-list');
  if (!contentArea) return;

  try {
    // Load user's forum threads
    var data = await ForumsAPI.getUserThreads(userId, 1, 20);
    var threads = data.threads || [];

    if (threads.length === 0) {
      PageInit.showEmpty(contentArea, 'Aucune activite forum', 'Pas encore de discussions publiees');
      return;
    }

    contentArea.innerHTML = '';
    threads.forEach(function(thread) {
      var date = PageInit.timeAgo ? PageInit.timeAgo(thread.created_at || thread.createdAt) : '';
      var replies = thread.reply_count || (thread.replies ? thread.replies.length : 0);
      contentArea.insertAdjacentHTML('beforeend',
        '<div class="widget-box aua-fade-in" style="margin-bottom:12px;padding:20px;">' +
          '<div style="display:flex;justify-content:space-between;align-items:flex-start;">' +
            '<div style="flex:1;">' +
              '<a href="forums-discussion.html?id=' + thread.id + '" style="font-weight:700;font-size:15px;color:#3e3f5e;">' + thread.title + '</a>' +
              '<p style="font-size:12px;color:#9aa4bf;margin-top:4px;">' +
                (thread.category ? thread.category.name + ' &middot; ' : '') +
                replies + ' reponse' + (replies !== 1 ? 's' : '') + ' &middot; ' + date +
              '</p>' +
            '</div>' +
            '<span style="background:#f5f5fa;color:#9aa4bf;padding:4px 10px;border-radius:8px;font-size:11px;white-space:nowrap;">' +
              (thread.views || 0) + ' vues' +
            '</span>' +
          '</div>' +
          (thread.content ? '<p style="font-size:13px;color:#6e7194;margin-top:10px;line-height:1.5;max-height:60px;overflow:hidden;">' + thread.content.substring(0, 200) + '</p>' : '') +
        '</div>'
      );
    });
  } catch(e) {
    console.error('Forum activity error:', e);
    PageInit.showEmpty(contentArea, 'Aucune activite forum', 'Erreur de chargement');
  }
});
</script>
