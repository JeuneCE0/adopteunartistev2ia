<script src="js/vendor/tiny-slider.min.js"></script>
<!-- chartJS -->
<script src="js/vendor/Chart.bundle.min.js"></script>
<!-- global.chart -->
<script src="js/global/global.charts.js"></script>
<script src="js/api/groups.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;
  var groupId = PageInit.getUrlParam('id');
  if (!groupId) { window.location.href = 'groups.html'; return; }
  var group = await PageInit.loadGroupHeader(groupId);
  if (!group) return;
  var contentArea = document.querySelector('.grid.grid-9-3 .grid-column:first-child, .widget-box-content');
  if (contentArea) {
    contentArea.innerHTML = '<div class="widget-box aua-fade-in"><div class="widget-box-title"><h4>A propos</h4></div><div class="widget-box-content">' +
      '<p style="color:#3e3f5e;line-height:1.6;">' + (group.description || 'Aucune description') + '</p>' +
      '<div style="margin-top:20px;display:flex;gap:16px;flex-wrap:wrap;">' +
        '<div style="padding:12px 20px;background:#f5f5fa;border-radius:12px;"><p style="font-weight:700;font-size:18px;">' + (group.memberCount || 0) + '</p><p style="color:#9aa4bf;font-size:12px;">Membres</p></div>' +
        '<div style="padding:12px 20px;background:#f5f5fa;border-radius:12px;"><p style="font-weight:700;font-size:18px;">' + (group.type || 'Public') + '</p><p style="color:#9aa4bf;font-size:12px;">Type</p></div>' +
        '<div style="padding:12px 20px;background:#f5f5fa;border-radius:12px;"><p style="font-weight:700;font-size:18px;">' + PageInit.timeAgo(group.created_at || group.createdAt) + '</p><p style="color:#9aa4bf;font-size:12px;">Cree</p></div>' +
      '</div>' +
    '</div></div>';
  }
});
</script>
<%- include('../partials/footer') %>
