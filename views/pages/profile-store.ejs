      <!-- CREATE/EDIT PRODUCT MODAL -->
      <div id="product-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:99999;overflow-y:auto;">
        <div style="max-width:560px;margin:60px auto;background:#fff;border-radius:16px;padding:32px;position:relative;">
          <button id="product-modal-close" style="position:absolute;top:16px;right:16px;background:none;border:none;font-size:24px;cursor:pointer;color:#9aa4bf;">&times;</button>
          <h3 id="product-modal-title" style="font-size:18px;font-weight:700;margin-bottom:24px;">Ajouter un produit</h3>
          <form id="product-form">
            <input type="hidden" id="pf-id" value="">
            <div style="margin-bottom:16px;">
              <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Titre *</label>
              <input type="text" id="pf-title" required style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="Nom du produit ou service">
            </div>
            <div style="margin-bottom:16px;">
              <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Description</label>
              <textarea id="pf-description" rows="4" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;resize:vertical;" placeholder="Decrivez votre produit ou service..."></textarea>
            </div>
            <div style="display:flex;gap:12px;margin-bottom:16px;">
              <div style="flex:1;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Prix (EUR) *</label>
                <input type="number" id="pf-price" min="0" step="0.01" required style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="0.00">
              </div>
              <div style="flex:1;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Type</label>
                <select id="pf-type" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;background:#fff;">
                  <option value="digital">Digital</option>
                  <option value="physical">Physique</option>
                  <option value="service">Service</option>
                  <option value="commission">Commission</option>
                </select>
              </div>
            </div>
            <div style="display:flex;gap:12px;margin-bottom:16px;">
              <div style="flex:1;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Categorie</label>
                <input type="text" id="pf-category" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="Art, Musique, Design...">
              </div>
              <div style="flex:1;">
                <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Stock</label>
                <input type="number" id="pf-stock" min="-1" value="-1" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="-1 = illimite">
              </div>
            </div>
            <div style="margin-bottom:16px;">
              <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Image du produit</label>
              <input type="file" id="pf-image" accept="image/*" style="width:100%;padding:10px;border:1px solid #dedeea;border-radius:12px;font-size:13px;">
              <div id="pf-image-preview" style="margin-top:8px;display:none;">
                <img id="pf-image-preview-img" style="max-width:100%;max-height:160px;border-radius:8px;object-fit:cover;">
              </div>
            </div>
            <div style="margin-bottom:20px;">
              <label style="font-size:13px;font-weight:600;color:#3e3f5e;display:block;margin-bottom:6px;">Lien de telechargement (produit digital)</label>
              <input type="url" id="pf-download-url" style="width:100%;padding:10px 14px;border:1px solid #dedeea;border-radius:12px;font-size:14px;outline:none;" placeholder="https://...">
            </div>
            <div style="display:flex;gap:12px;">
              <button type="submit" id="pf-submit" class="button medium primary" style="flex:1;">Publier le produit</button>
              <button type="button" id="pf-cancel" class="button medium" style="flex:0;background:#eaeaf5;color:#3e3f5e;">Annuler</button>
            </div>
          </form>
        </div>
      </div>
      <!-- /CREATE/EDIT PRODUCT MODAL -->

      <!-- GRID -->
      <div class="grid grid-3-3-3-3 centered">
        <!-- PRODUCT PREVIEW -->
        <div class="product-preview">
