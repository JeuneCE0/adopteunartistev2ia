<%- include('../partials/scripts') %>
<!-- tiny-slider -->
<script src="js/vendor/tiny-slider.min.js"></script>
<script src="js/api/friends.js"></script>
<script src="js/api/messages.js"></script>
<script src="js/api/users.js"></script>
<script src="js/api/posts.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;
  var userId = PageInit.getUrlParam('id') || PageInit.user.id;
  await PageInit.loadProfileHeader(userId);
  try {
    var data = await PostsAPI.getUserPosts(userId, 1, 20);
    var posts = (data.posts || []).filter(function(p) { return !p.image_url; });
    var grid = document.querySelector('.grid.grid-1, .grid.grid-3-6-3 .grid-column:first-child, .post-peek-list');
    if (grid) {
      if (posts.length === 0) {
        grid.innerHTML = '<div style="text-align:center;padding:40px;"><p style="color:#9aa4bf;">Aucun article de blog</p></div>';
      } else {
        grid.innerHTML = '';
        posts.forEach(function(post) { grid.insertAdjacentHTML('beforeend', PageInit.createPostHTML(post)); });
      }
    }
  } catch(e) { console.error('Blog load error:', e); }
});
</script>
