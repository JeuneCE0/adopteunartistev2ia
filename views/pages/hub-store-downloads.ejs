<script src="js/global/global.accordions.js"></script>
<!-- global.popups -->
<script src="js/global/global.popups.js"></script>
<!-- API modules -->
<script src="js/api/auth.js"></script>
<script src="js/api/orders.js"></script>
<script src="js/utils/page-init.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;
  var contentArea = document.querySelector('.account-hub-content .notification-box-list, .account-hub-content .widget-box-content, .account-hub-content .table-body');
  if (!contentArea) contentArea = document.querySelector('.account-hub-content');
  if (!contentArea) return;

  PageInit.showLoading(contentArea);
  try {
    var data = await OrdersAPI.getMyOrders();
    var orders = data.orders || [];
    if (orders.length === 0) {
      contentArea.innerHTML = '<div style="text-align:center;padding:60px;">' +
        '<div style="font-size:48px;margin-bottom:16px;">&#x1F6D2;</div>' +
        '<p style="color:#9aa4bf;font-size:16px;">Aucune commande</p>' +
        '<p style="color:#9aa4bf;font-size:13px;margin-top:8px;">Vos commandes apparaitront ici</p>' +
        '<a href="marketplace.html" class="button small secondary" style="margin-top:16px;">Parcourir le marketplace</a>' +
      '</div>';
    } else {
      var statusLabels = { pending: 'En attente', paid: 'Payee', shipped: 'Expediee', delivered: 'Livree', completed: 'Terminee', refunded: 'Remboursee', cancelled: 'Annulee' };
      var statusColors = { pending: '#ff9800', paid: '#2196f3', shipped: '#9c27b0', delivered: '#4caf50', completed: '#4caf50', refunded: '#e74c3c', cancelled: '#9e9e9e' };
      var html = '';
      orders.forEach(function(o) {
        var status = o.status || 'pending';
        var label = statusLabels[status] || status;
        var color = statusColors[status] || '#9aa4bf';
        var itemCount = o.items ? o.items.length : 0;
        var itemsText = itemCount > 0 ? itemCount + ' article' + (itemCount > 1 ? 's' : '') : '';

        html += '<div class="aua-fade-in" style="padding:16px;border-bottom:1px solid #eaeaf5;display:flex;justify-content:space-between;align-items:center;">' +
          '<div style="flex:1;">' +
            '<div style="display:flex;align-items:center;gap:10px;">' +
              '<p style="font-weight:700;font-size:15px;">Commande #' + o.id + '</p>' +
              '<span style="background:' + color + ';color:#fff;padding:2px 10px;border-radius:8px;font-size:11px;font-weight:600;">' + label + '</span>' +
            '</div>' +
            '<p style="font-size:12px;color:#9aa4bf;margin-top:6px;">' +
              PageInit.timeAgo(o.created_at || o.createdAt) +
              (itemsText ? ' &middot; ' + itemsText : '') +
            '</p>' +
          '</div>' +
          '<p style="font-weight:700;color:#615dfa;font-size:18px;">' + parseFloat(o.total || 0).toFixed(2) + ' EUR</p>' +
        '</div>';
      });
      contentArea.innerHTML = html;
    }
  } catch(e) {
    console.error('Orders error:', e);
    PageInit.showEmpty(contentArea, 'Commandes', 'Erreur de chargement');
  }
});
</script>
