<script src="js/global/global.accordions.js"></script>
<!-- API modules -->
<script src="js/api/auth.js"></script>
<script src="js/api/friends.js"></script>
<script src="js/utils/page-init.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;

  // Load friend requests
  try {
    var data = await FriendsAPI.getRequests();
    var requests = data.requests || data || [];
    if (!Array.isArray(requests)) requests = [];

    // Update title count
    var titleSpan = document.querySelector('.account-hub-content .section-title .highlighted');
    if (titleSpan) titleSpan.textContent = requests.length;

    // Find the notification box list in account-hub-content
    var boxList = document.querySelector('.account-hub-content .notification-box-list');
    if (boxList) {
      if (requests.length === 0) {
        boxList.innerHTML = '<div style="text-align:center;padding:40px;"><p style="color:#9aa4bf;font-size:14px;">Aucune demande d\'ami en attente</p><a href="members.html" class="button secondary" style="margin-top:12px;">Trouver des membres</a></div>';
      } else {
        boxList.innerHTML = '';
        requests.forEach(function(req) {
          boxList.insertAdjacentHTML('beforeend', PageInit.createRequestHTML(req));
        });

        // Add accept/decline handlers
        boxList.querySelectorAll('.action-request.accept').forEach(function(btn) {
          btn.addEventListener('click', async function() {
            var reqId = this.getAttribute('data-request-id');
            try {
              await FriendsAPI.accept(reqId);
              var box = this.closest('.notification-box');
              if (box) {
                box.style.opacity = '0.5';
                box.querySelector('.action-request-list').innerHTML = '<span style="color:#4caf50;font-size:13px;">Accepte !</span>';
              }
            } catch(e) { console.error('Accept error:', e); }
          });
        });

        boxList.querySelectorAll('.action-request.decline').forEach(function(btn) {
          btn.addEventListener('click', async function() {
            var reqId = this.getAttribute('data-request-id');
            try {
              await FriendsAPI.reject(reqId);
              var box = this.closest('.notification-box');
              if (box) box.remove();
            } catch(e) { console.error('Reject error:', e); }
          });
        });
      }
    }
  } catch(e) {
    console.error('Friend requests load error:', e);
  }
});
</script>
