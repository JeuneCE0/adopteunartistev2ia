<!-- global.accordions -->
<script src="js/global/global.accordions.js"></script>
<script src="js/api/products.js"></script>
<script src="js/api/orders.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;

  var contentArea = document.querySelector('.content-grid');
  if (!contentArea) return;

  // Load cart items for order summary
  try {
    var data = await ProductsAPI.getCart();
    var items = data.items || data.cart || [];

    if (items.length === 0) {
      contentArea.innerHTML = '<div style="text-align:center;padding:60px;">' +
        '<p style="color:#9aa4bf;font-size:16px;">Votre panier est vide</p>' +
        '<a href="marketplace.html" class="button secondary" style="margin-top:16px;">Parcourir le marketplace</a></div>';
      return;
    }

    var total = 0;
    var summaryHTML = '';
    items.forEach(function(item) {
      var product = item.Product || item.product || item;
      var price = parseFloat(product.price || 0);
      var qty = item.quantity || 1;
      total += price * qty;
      summaryHTML += '<div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #f0f0fa;">' +
        '<img src="' + (product.image_url || 'img/marketplace/01.jpg') + '" style="width:60px;height:60px;object-fit:cover;border-radius:8px;">' +
        '<div style="flex:1;"><p style="font-weight:700;font-size:14px;">' + (product.title || '') + '</p>' +
        '<p style="color:#9aa4bf;font-size:12px;">Qte: ' + qty + '</p></div>' +
        '<p style="font-weight:700;color:#615dfa;">' + (price * qty).toFixed(2) + ' EUR</p></div>';
    });

    contentArea.innerHTML = '<div style="max-width:700px;margin:40px auto;">' +
      '<h2 style="font-size:20px;font-weight:700;margin-bottom:24px;">Recapitulatif de commande</h2>' +
      '<div class="widget-box" style="padding:24px;">' +
        summaryHTML +
        '<div style="display:flex;justify-content:space-between;align-items:center;padding:20px 0;margin-top:8px;">' +
          '<p style="font-size:16px;font-weight:700;">Total</p>' +
          '<p style="font-size:22px;font-weight:700;color:#615dfa;">' + total.toFixed(2) + ' EUR</p>' +
        '</div>' +
        '<div style="background:#f5f5fa;border-radius:12px;padding:16px;margin-bottom:20px;">' +
          '<p style="font-size:13px;color:#6e7194;">&#x1F6E1; Paiement securise - Les artistes seront notifies de votre commande.</p>' +
        '</div>' +
        '<div style="display:flex;gap:12px;justify-content:flex-end;">' +
          '<a href="marketplace-cart.html" class="button secondary">Retour au panier</a>' +
          '<button id="confirm-order-btn" class="button primary" style="min-width:200px;">Confirmer la commande</button>' +
        '</div>' +
      '</div>' +
      '<div id="order-success" style="display:none;text-align:center;padding:40px;">' +
        '<div style="font-size:48px;margin-bottom:16px;">&#x2705;</div>' +
        '<h2 style="font-size:20px;font-weight:700;margin-bottom:8px;">Commande confirmee !</h2>' +
        '<p style="color:#9aa4bf;margin-bottom:20px;">Les vendeurs ont ete notifies. Vous recevrez une notification quand votre commande sera traitee.</p>' +
        '<div style="display:flex;gap:12px;justify-content:center;">' +
          '<a href="hub-store-downloads.html" class="button primary">Mes commandes</a>' +
          '<a href="marketplace.html" class="button secondary">Continuer mes achats</a>' +
        '</div>' +
      '</div>' +
    '</div>';

    document.getElementById('confirm-order-btn').addEventListener('click', async function() {
      this.disabled = true;
      this.textContent = 'Traitement en cours...';
      try {
        var orderData = await OrdersAPI.checkout();
        // Show success
        document.querySelector('.widget-box').style.display = 'none';
        document.getElementById('order-success').style.display = '';
        PageInit.toast('Commande passee avec succes !', 'success');
      } catch(err) {
        PageInit.toast(err.message || 'Erreur lors de la commande', 'error');
        this.disabled = false;
        this.textContent = 'Confirmer la commande';
      }
    });
  } catch(e) {
    console.error('Checkout error:', e);
    contentArea.innerHTML = '<div style="text-align:center;padding:60px;"><p style="color:#e74c3c;">Erreur de chargement du panier</p></div>';
  }
});
</script>
