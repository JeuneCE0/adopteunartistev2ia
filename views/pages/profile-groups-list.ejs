<!-- tiny-slider -->
<script src="js/vendor/tiny-slider.min.js"></script>
<!-- API modules -->
<script src="js/api/auth.js"></script>
<script src="js/api/friends.js"></script>
<script src="js/api/messages.js"></script>
<script src="js/api/users.js"></script>
<script src="js/api/groups.js"></script>
<script src="js/utils/page-init.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;

  var userId = PageInit.getUrlParam('id') || PageInit.user.id;
  var isOwnProfile = (String(userId) === String(PageInit.user.id));

  // Load profile header
  var profile = await PageInit.loadProfileHeader(userId);

  // Update section pretitle
  var pretitle = document.querySelector('.section-pretitle');
  if (pretitle && profile) {
    pretitle.textContent = (profile.display_name || profile.username) + ' -';
  }

  // Load user's groups
  try {
    var data = await apiRequest('/api/groups/user/' + userId);
    var groups = data.groups || [];
    var total = data.total || groups.length;

    // Find the grid and clear static content
    var grid = document.querySelector('.grid.grid-4-4-4.centered');
    if (!grid) grid = document.querySelector('.grid.grid-3-3-3-3.centered');
    if (!grid) grid = document.querySelector('.grid.grid-1');
    if (grid) {
      if (groups.length === 0) {
        grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;"><p style="color:#9aa4bf;font-size:14px;">Aucun groupe rejoint</p><a href="groups.html" class="button secondary" style="margin-top:12px;">Decouvrir des groupes</a></div>';
      } else {
        grid.innerHTML = '';
        groups.forEach(function(group) {
          grid.insertAdjacentHTML('beforeend', PageInit.createGroupCardHTML(group));
        });
      }
    }

    // Update view-action links to preserve user id
    var viewLinks = document.querySelectorAll('.view-actions a.view-action');
    viewLinks.forEach(function(link) {
      var href = link.getAttribute('href');
      if (href && href.indexOf('?') === -1 && !isOwnProfile) {
        link.href = href + '?id=' + userId;
      }
    });
  } catch(e) {
    console.error('Groups load error:', e);
    var grid = document.querySelector('.grid.grid-4-4-4.centered, .grid.grid-3-3-3-3.centered, .grid.grid-1');
    if (grid) {
      grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;"><p style="color:#9aa4bf;">Erreur de chargement des groupes</p></div>';
    }
  }
});
</script>
<%- include('../partials/footer') %>
