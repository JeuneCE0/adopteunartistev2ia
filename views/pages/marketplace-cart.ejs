<script src="js/api/products.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;
  try {
    var data = await ProductsAPI.getCart();
    var items = data.items || data.cart || [];
    var contentArea = document.querySelector('.cart-item-list, .section-cart, .content-grid .grid');
    if (!contentArea) contentArea = document.querySelector('.content-grid');
    if (contentArea) {
      if (items.length === 0) {
        contentArea.innerHTML = '<div style="text-align:center;padding:60px;"><p style="color:#9aa4bf;font-size:16px;">Votre panier est vide</p><a href="marketplace.html" class="button secondary" style="margin-top:16px;">Parcourir le marketplace</a></div>';
      } else {
        var total = 0;
        var html = '<div style="max-width:800px;margin:0 auto;">';
        items.forEach(function(item) {
          var product = item.Product || item.product || item;
          var price = product.price || 0;
          var qty = item.quantity || 1;
          total += price * qty;
          html += '<div class="cart-item" data-item-id="' + item.id + '" style="display:flex;align-items:center;gap:16px;padding:16px;border-bottom:1px solid #eaeaf5;">' +
            '<img src="' + (product.image_url || 'img/marketplace/01.jpg') + '" style="width:80px;height:80px;object-fit:cover;border-radius:8px;">' +
            '<div style="flex:1;"><p style="font-weight:700;">' + (product.title || product.name) + '</p><p style="color:#9aa4bf;font-size:13px;">Qte: ' + qty + '</p></div>' +
            '<p style="font-weight:700;color:#615dfa;">' + (price * qty) + ' EUR</p>' +
            '<button class="remove-cart-item" data-item-id="' + item.id + '" style="background:none;border:none;color:#e74c3c;cursor:pointer;font-size:18px;">x</button>' +
          '</div>';
        });
        html += '<div style="padding:20px;text-align:right;">' +
          '<p style="font-size:18px;font-weight:700;">Total: ' + total + ' EUR</p>' +
          '<a href="marketplace-checkout.html" class="button primary" style="margin-top:12px;">Passer la commande</a>' +
        '</div></div>';
        contentArea.innerHTML = html;
        // Wire remove buttons
        contentArea.querySelectorAll('.remove-cart-item').forEach(function(btn) {
          btn.addEventListener('click', async function() {
            try {
              await ProductsAPI.removeFromCart(this.getAttribute('data-item-id'));
              this.closest('.cart-item').remove();
            } catch(e) { console.error('Remove error:', e); }
          });
        });
      }
    }
  } catch(e) { console.error('Cart load error:', e); }
});
</script>
