<!-- google maps api -->
<script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap" async defer></script>
<script src="js/api/auth.js"></script>
<script src="js/api/events.js"></script>
<script src="js/utils/page-init.js"></script>
<script>
document.addEventListener('DOMContentLoaded', async function() {
  var ok = await PageInit.init();
  if (!ok) return;
  try {
    var data = await EventsAPI.list({ limit: 50 });
    var events = data.events || [];
    var now = new Date();
    var weekEnd = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
    var weekEvents = events.filter(function(e) {
      var d = new Date(e.start_date || e.date);
      return d >= now && d <= weekEnd;
    });
    var grid = document.querySelector('.calendar-events-list, .event-list, .grid');
    if (grid) {
      if (weekEvents.length === 0) {
        grid.innerHTML = '<div style="text-align:center;padding:40px;"><p style="color:#9aa4bf;">Aucun evenement cette semaine</p><a href="events.html" class="button secondary" style="margin-top:12px;">Voir tous les evenements</a></div>';
      } else {
        var html = '';
        weekEvents.forEach(function(evt) {
          var d = new Date(evt.start_date || evt.date);
          html += '<div class="event-preview" style="padding:16px;border-bottom:1px solid #eaeaf5;">' +
            '<p style="font-weight:700;font-size:14px;">' + evt.title + '</p>' +
            '<p style="font-size:12px;color:#9aa4bf;margin-top:4px;">' + (evt.location || '') + '</p>' +
            '<p style="font-size:12px;color:#615dfa;margin-top:4px;">' + d.toLocaleDateString('fr-FR') + ' a ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'}) + '</p>' +
          '</div>';
        });
        grid.innerHTML = html;
      }
    }
  } catch(e) { console.error('Weekly events error:', e); }
});
</script>
